{
    "classifier_route": "hybrid_rankaware",
    "classifier_enable_legacy_fallback": true,
    "rate_limit_seconds": 3.0,
    "rate_limit_max_requests": 100,
    "feature_enable_disambiguation": true,
    "feature_enable_cache": true,
    "feature_enable_batch_processing": true,
    "feature_enable_metrics": true,
    "feature_enable_detailed_logging": false,
    "feature_enable_fact_verification": true,
    "feature_enable_assisted_decoding": false,
    "feature_enable_geo_validation": false,
    "feature_enable_context_disambiguation": true,
    "feature_enable_redis": true,
    "redis_host": "localhost",
    "redis_port": 6379,
    "redis_db": 0,
    "redis_password": "",
    "feature_enable_active_learning": true,
    "active_learning_confidence_threshold": 70.0,
    "active_learning_db_path": "data/runtime/active_learning.db",
    "active_learning_base_data_path": "data/runtime/active_learning_base.jsonl",
    "feature_enable_knowledge_graph": true,
    "knowledge_graph_path": "data/runtime/knowledge_graph.json",
    "knowledge_graph_top_k": 3,
    "feature_enable_neo4j": true,
    "neo4j_uri": "bolt://localhost:7687",
    "neo4j_user": "neo4j",
    "neo4j_password": "your_password_here",
    "cache_ttl": 3600,
    "cache_local_size": 10000,
    "batch_max_size": 10,
    "batch_max_workers": 4,
    "generation_max_tokens": 512,
    "generation_temperature": 0.7,
    "retrieval_top_k": 5,
    "rag_backend": "hybrid",
    "rag_enable_query_rewrite": true,
    "rag_multi_query_count": 4,
    "rag_dense_weight": 0.68,
    "rag_sparse_weight": 0.32,
    "rag_enable_chunking": true,
    "rag_chunk_size": 400,
    "rag_chunk_overlap": 60,
    "rag_enable_reranker": true,
    "rag_enable_graph_augment": true,
    "rag_enable_feedback_boost": true,
    "rag_enable_post_processing": true,
    "model_manifest_path": "data/runtime/model_manifest.json",
    "feature_enforce_model_manifest": false
}
