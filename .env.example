# 环境配置示例
# 复制此文件为 .env 并填写实际值

# ==================== 服务配置 ====================
# 应用端口
ENHANCED_APP_PORT=5000

# 最大生成token数
MAX_NEW_TOKENS=300

# ==================== 模型路径 ====================
# 分类模型目录
CLASSIFIER_MODEL_DIR=./final_model_fgm

# 分类基础模型
CLASSIFIER_BASE_MODEL=./local_roberta_model

# 生成基础模型
GENERATOR_BASE_MODEL=./qwen_models/Qwen/Qwen2___5-1___5B-Instruct

# LoRA微调目录
GENERATOR_LORA_DIR=./qwen_reply_model

# Draft小模型 (用于辅助解码加速)
GENERATOR_DRAFT_MODEL=./qwen_models/Qwen/Qwen2.5-0.5B-Instruct

# ==================== 功能开关 ====================
# 是否启用事实验证
ENABLE_FACT_VERIFICATION=true

# 是否启用辅助解码 (使用draft模型加速)
ENABLE_ASSISTED_DECODING=true

# 是否使用精选地名别名
USE_CURATED_ALIASES=true

# 事实验证日志级别: debug, info, warning, error
VERIFICATION_LOG_LEVEL=warning

# ==================== 数据库配置 ====================
# 反馈数据库路径
FEEDBACK_DB_PATH=./data/runtime/feedback.db

# ==================== 安全配置 ====================
# JWT密钥 (请生成随机字符串)
SECRET_KEY=your-secret-key-change-this-in-production

# 加密密钥 (请生成随机字符串)
ENCRYPTION_KEY=your-encryption-key-change-this

# API密钥 (用于内部服务调用)
API_KEY=your-api-key-change-this

# 密码盐值
PASSWORD_SALT=your-password-salt-change-this

# ==================== 日志配置 ====================
# 日志级别: DEBUG, INFO, WARNING, ERROR
LOG_LEVEL=INFO

# 日志目录
LOG_DIR=./logs

# ==================== 外部服务配置 ====================
# 高德地图API密钥 (可选)
AMAP_API_KEY=your-amap-api-key

# 新闻API密钥 (可选)
NEWS_API_KEY=your-news-api-key

# ==================== 调度配置 ====================
# 是否启用定时任务
ENABLE_SCHEDULER=true

# 政务数据爬取间隔 (小时)
GOV_CRAWL_INTERVAL=24

# 新闻更新间隔 (小时)
NEWS_UPDATE_INTERVAL=4
