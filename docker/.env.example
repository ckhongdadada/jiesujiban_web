# 接诉即办系统 Docker 环境配置
# 复制此文件为 .env 并修改配置

# ==================== 应用配置 ====================
APP_PORT=5000
LOG_LEVEL=INFO
COMPOSE_PROJECT_NAME=jsjb

# ==================== Redis 配置 ====================
REDIS_PORT=6379

# ==================== Neo4j 配置 ====================
NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=password123

# ==================== 监控配置（可选） ====================
PROMETHEUS_PORT=9090
GRAFANA_PORT=3000
GRAFANA_USER=admin
GRAFANA_PASSWORD=admin

# ==================== 模型路径（本地挂载） ====================
# 模型文件通过 volume 挂载，无需在容器内下载。
# docker-compose.yml 默认挂载 ./checkpoints 到 /app/checkpoints。
# 确保本地 checkpoints 目录包含：
# - checkpoints/classifier/final_model_hybrid_v3_32cls/ (分类微调权重)
# - checkpoints/generator/base_models/qwen_models/Qwen/Qwen2___5-1___5B-Instruct/ (生成基础模型)
# - checkpoints/generator/lora/qwen_reply_model/ (生成 LoRA 权重)
